---
import { refusePreview } from '@hollware/astro'
import HollwareContent from '@hollware/astro/HollwareContent.astro'
import HollwareImage from '@hollware/astro/HollwareImage.astro'
import { getLiveEntry } from 'astro:content'
import Callout from '../../components/Callout.astro'
import Page from '../../layouts/Page.astro'

const preview = Astro.locals.hollwarePreview

const { entry, error } = await getLiveEntry('blog', { id: Astro.params.slug ?? '', preview })
if (error || !entry) {
  if (error) refusePreview(Astro.locals, error)
  return new Response('Not found', { status: 404 })
}
---

<Page title={String(entry.data['title'] ?? entry.id)}>
  <article>
    <h1>{String(entry.data['title'] ?? entry.id)}</h1>
    <HollwareImage entry={entry} field="cover" />
    <HollwareContent entry={entry} components={{ callout: Callout }} />
  </article>
</Page>
