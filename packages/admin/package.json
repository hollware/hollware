{
  "name": "@hollware/admin",
  "version": "1.0.0-rc.4",
  "description": "The Hollware admin, prebuilt for the user's Worker.",
  "homepage": "https://hollware.com",
  "bugs": {
    "url": "https://github.com/hollware/hollware/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollware/hollware.git",
    "directory": "packages/admin"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && vp build -c vite.app.config.ts",
    "test": "vp test",
    "publint": "publint --strict"
  },
  "devDependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/merge": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@comark/vue": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@hollware/core": "workspace:*",
    "@iconify-json/lucide": "catalog:",
    "@iconify/utils": "catalog:",
    "@iconify/vue": "catalog:",
    "@lezer/highlight": "catalog:",
    "@nuxt/ui": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "codemirror": "catalog:",
    "comark": "catalog:",
    "publint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
