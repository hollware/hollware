{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Nuxt's and Nitro's packages declare their types for bundlers, as the apps that use this
    // module resolve them.
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
