{
  "name": "@hollware/server",
  "version": "1.0.0-rc.9",
  "description": "The Hollware Worker: operation handlers, MCP, RPC, HTTP, auth and D1 migrations.",
  "homepage": "https://hollware.com",
  "bugs": {
    "url": "https://github.com/hollware/hollware/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollware/hollware.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "publint": "publint --strict",
    "types": "wrangler types",
    "types:check": "wrangler types --check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "catalog:",
    "@hollware/core": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@hollware/agents": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
