{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hollware-playground",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "global_fetch_strictly_public",
  ],
  "send_metrics": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "hollware-playground-events" }],
    "consumers": [
      {
        "queue": "hollware-playground-events",
        "max_retries": 5,
        "dead_letter_queue": "hollware-playground-events-dlq",
      },
      { "queue": "hollware-playground-events-dlq" },
    ],
  },
  "assets": {
    "directory": "node_modules/@hollware/admin/dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/admin/assets/*"],
  },
  "vars": {
    "HOLLWARE_PUBLIC_URL": "http://localhost:5199",
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    {
      "name": "HOLLWARE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollware-playground",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "node_modules/@hollware/server/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "hollware-playground-media" },
    { "binding": "BACKUPS", "bucket_name": "hollware-playground-backups" },
  ],
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "PROBE", "service": "hollware-playground", "entrypoint": "Probe" }],
  "env": {
    "demo": {
      "name": "hollware-demo",
      "placement": { "mode": "smart", "hint": "enam" },
      "vars": {
        "HOLLWARE_PUBLIC_URL": "https://cms.demo.hollware.com",
        "HOLLWARE_EMBEDDING_MODEL": "@cf/baai/bge-m3",
      },
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "hollware-demo-bge-m3" }],
      "routes": [{ "pattern": "cms.demo.hollware.com", "custom_domain": true }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hollware-demo-media" }],
      "images": { "binding": "IMAGES" },
      "triggers": { "crons": ["* * * * *"] },
      "services": [
        { "binding": "AGENTS", "service": "hollware-agents-demo", "entrypoint": "HollwareAgents" },
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "f4b6a249127848139b0cb6c400ce0e0c" }],
      "ratelimits": [
        {
          "name": "HOLLWARE_RATE_LIMIT",
          "namespace_id": "1101",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hollware-demo",
          "database_id": "c11a42ee-5cf6-4809-911b-bd941affca6e",
          "migrations_dir": "node_modules/@hollware/server/migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "hollware-demo-events" }],
        "consumers": [
          {
            "queue": "hollware-demo-events",
            "max_retries": 5,
            "dead_letter_queue": "hollware-demo-events-dlq",
          },
          { "queue": "hollware-demo-events-dlq" },
        ],
      },
    },
    "staging": {
      "name": "hollware-staging",
      "workers_dev": true,
      "placement": { "mode": "smart", "hint": "enam" },
      "vars": {
        "HOLLWARE_PUBLIC_URL": "https://hollware-staging.sergioazoc.workers.dev",
        "HOLLWARE_EMBEDDING_MODEL": "@cf/baai/bge-m3",
      },
      "triggers": { "crons": ["* * * * *"] },
      "services": [
        {
          "binding": "AGENTS",
          "service": "hollware-agents-staging",
          "entrypoint": "HollwareAgents",
        },
      ],
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "hollware-staging-bge-m3" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hollware-staging-media" }],
      "images": { "binding": "IMAGES" },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "e85a150e74794fd6a8d5d83625d6e0ed" }],
      "ratelimits": [
        {
          "name": "HOLLWARE_RATE_LIMIT",
          "namespace_id": "1201",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hollware-staging",
          "database_id": "64b0a941-34ed-4da9-b439-22fcfd15d12a",
          "migrations_dir": "node_modules/@hollware/server/migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "hollware-staging-events" }],
        "consumers": [
          {
            "queue": "hollware-staging-events",
            "max_retries": 5,
            "dead_letter_queue": "hollware-staging-events-dlq",
          },
          { "queue": "hollware-staging-events-dlq" },
        ],
      },
    },
  },
}
