{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-hollware",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "global_fetch_strictly_public",
  ],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "hollware-events" }],
    "consumers": [
      { "queue": "hollware-events", "max_retries": 5, "dead_letter_queue": "hollware-events-dlq" },
      { "queue": "hollware-events-dlq" },
    ],
  },
  "assets": {
    "directory": "node_modules/@hollware/admin/dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/admin/assets/*"],
  },
  "vars": {
    "HOLLWARE_PUBLIC_URL": "http://localhost:5199",
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "ratelimits": [
    {
      "name": "HOLLWARE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-hollware",
      "migrations_dir": "node_modules/@hollware/server/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "my-hollware-media" }],
  "images": { "binding": "IMAGES" },
}
