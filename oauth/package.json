{
  "name": "@hollware/spike-oauth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:roles": "vp build --config vite.roles.config.ts",
    "test": "vp test --root ../.. --project 'spike-oauth:*'",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "check:startup": "vp build && wrangler check startup --outfile .wrangler/worker-startup.cpuprofile",
    "smoke:built": "node scripts/smoke-built.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "hono": "5.0.0-rc.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
