{
  "name": "@hollware/agents",
  "version": "1.0.0-rc.3",
  "description": "Agents for Hollware on Cloudflare: an editorial reviewer, a translator and a weekly auditor, none of which publishes.",
  "homepage": "https://hollware.com",
  "bugs": {
    "url": "https://github.com/hollware/hollware/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollware/hollware.git",
    "directory": "packages/agents"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@hollware/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
