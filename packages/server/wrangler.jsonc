{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hollware-server-tests",
  "main": "tests/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "global_fetch_strictly_public",
  ],
  "send_metrics": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hollware-server-tests" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollware-server-tests",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
