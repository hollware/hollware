{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Not a Worker anyone deploys: the configuration the tests of this package run under, with
  // the bindings Hollware needs. A user's project has its own (templates/starter).
  "name": "hollware-server-tests",
  "main": "tests/worker.ts",
  // The latest compatibility date the workerd bundled with wrangler supports.
  "compatibility_date": "2026-10-06",
  // From the 2026-08-04 compatibility date Workers turn Node.js compatibility on by default.
  // Hollware runs without it, and its runtime types (worker-configuration.d.ts) say so.
  // global_fetch_strictly_public: the OAuth server fetches the metadata documents of clients
  // (CIMD) over the public internet only, never through the zone (ADR-026).
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "global_fetch_strictly_public",
  ],
  // No anonymous wrangler telemetry from this repository.
  "send_metrics": false,
  // The OAuth server's clients, grants and tokens (ADR-026). Placeholder id: local development and
  // tests never contact Cloudflare; a deploy needs the id of a namespace made with
  // `wrangler kv namespace create`.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollware-server-tests",
      // Placeholder: the tests run on a local database and never contact Cloudflare.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
