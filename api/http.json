{
  "components": {
    "securitySchemes": {
      "token": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Hollware read API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/redirects": {
      "get": {
        "operationId": "list_redirects",
        "parameters": [
          {
            "in": "query",
            "name": "collection",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The old paths of entries that moved, and where each goes now",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the ETag of If-None-Match is current."
          },
          "401": {
            "description": "No token, or one that is unknown, expired or revoked. The challenge names the protected resource metadata."
          },
          "403": {
            "description": "The token lacks content:read."
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "operationId": "search",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "collection",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "passages",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "minScore",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The published entries that match q, best first",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the ETag of If-None-Match is current."
          },
          "401": {
            "description": "No token, or one that is unknown, expired or revoked. The challenge names the protected resource metadata."
          },
          "403": {
            "description": "The token lacks content:read."
          }
        }
      }
    },
    "/v1/site": {
      "get": {
        "operationId": "describe_site",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The site",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the ETag of If-None-Match is current."
          },
          "401": {
            "description": "No token, or one that is unknown, expired or revoked. The challenge names the protected resource metadata."
          },
          "403": {
            "description": "The token lacks content:read."
          }
        }
      }
    },
    "/v1/{collection}": {
      "get": {
        "operationId": "list_entries",
        "parameters": [
          {
            "in": "path",
            "name": "collection",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A page of published entries",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the ETag of If-None-Match is current."
          },
          "401": {
            "description": "No token, or one that is unknown, expired or revoked. The challenge names the protected resource metadata."
          },
          "403": {
            "description": "The token lacks content:read."
          }
        }
      }
    },
    "/v1/{collection}/navigation": {
      "get": {
        "operationId": "get_navigation",
        "parameters": [
          {
            "in": "path",
            "name": "collection",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The published entries of the collection in the locale, grouped and ordered for a sidebar",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the ETag of If-None-Match is current."
          },
          "401": {
            "description": "No token, or one that is unknown, expired or revoked. The challenge names the protected resource metadata."
          },
          "403": {
            "description": "The token lacks content:read."
          },
          "422": {
            "description": "The collection has more than 1,000 published entries in the locale"
          }
        }
      }
    },
    "/v1/{collection}/translations/{group}": {
      "get": {
        "operationId": "get_translations",
        "parameters": [
          {
            "in": "path",
            "name": "collection",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "group",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The published entries of the group",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the ETag of If-None-Match is current."
          },
          "401": {
            "description": "No token, or one that is unknown, expired or revoked. The challenge names the protected resource metadata."
          },
          "403": {
            "description": "The token lacks content:read."
          },
          "404": {
            "description": "No such group"
          }
        }
      }
    },
    "/v1/{collection}/{locale}/{slug}": {
      "get": {
        "operationId": "get_entry",
        "parameters": [
          {
            "in": "path",
            "name": "collection",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "locale",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "formats",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "related",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "references",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "preview",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "A published entry; with a valid preview token, its latest revision, uncacheable and with no ETag",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the ETag of If-None-Match is current."
          },
          "400": {
            "description": "The preview token is expired, forged or for another entry"
          },
          "401": {
            "description": "No token, or one that is unknown, expired or revoked. The challenge names the protected resource metadata."
          },
          "403": {
            "description": "The token lacks content:read."
          },
          "404": {
            "description": "No such published entry"
          }
        }
      }
    }
  },
  "security": [
    {
      "token": []
    }
  ]
}
