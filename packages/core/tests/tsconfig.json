  // source they import keeps its own, stricter environment in ../tsconfig.json (ADR-018).
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [".", "../vite.config.ts", "../vitest.workerd.config.ts"]
}
