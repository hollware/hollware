{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hollware-playground",
  "main": "src/index.ts",
  // The latest compatibility date the workerd bundled with wrangler supports.
  "compatibility_date": "2026-10-06",
  // From the 2026-08-04 compatibility date Workers turn Node.js compatibility on by default.
  // Hollware runs without it, and so does everything that tests Hollware.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  // No anonymous wrangler telemetry from this repository.
  "send_metrics": false,
  // Every minute: publishes the scheduled entries whose time has come (ADR-025).
  "triggers": { "crons": ["* * * * *"] },
  // The publication events (ADR-025): the Worker sends them, consumes them, and keeps the ones it
  // could not deliver after five tries in the dead-letter queue.
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "hollware-playground-events" }],
    "consumers": [
      {
        "queue": "hollware-playground-events",
        "max_retries": 5,
        "dead_letter_queue": "hollware-playground-events-dlq",
      },
    ],
  },
  "vars": {
    // The only Host and Origin Hollware answers. This is the URL `vp dev` serves; the harness
    // tests override it with http://hollware.test (test/harness/workers.ts).
    "HOLLWARE_PUBLIC_URL": "http://localhost:5199",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollware-playground",
      // Placeholder: local development, tests and dry runs never contact Cloudflare.
      // A real deploy needs the id of a database created with `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // The server package ships its migrations; the playground applies them as they are.
      "migrations_dir": "node_modules/@hollware/server/migrations",
    },
  ],
  "services": [
    // Only for the tests of this repository: a binding of the Worker to its own `Probe`
    // entrypoint (src/probe.ts), which is how a Node.js test asks the isolate which Node.js
    // globals it has. A Hollware project has neither the binding nor the class.
    { "binding": "PROBE", "service": "hollware-playground", "entrypoint": "Probe" },
  ],
}
