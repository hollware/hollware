{
  "name": "@hollware/core",
  "version": "1.0.0-rc.5",
  "description": "Contracts, operation specs, schemas and the Markdown pipeline of Hollware. No Cloudflare dependencies.",
  "homepage": "https://hollware.com",
  "bugs": {
    "url": "https://github.com/hollware/hollware/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollware/hollware.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./webhooks": "./src/webhooks.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./webhooks": {
        "types": "./dist/webhooks.d.mts",
        "default": "./dist/webhooks.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@comark/html": "catalog:",
    "@standard-schema/spec": "catalog:",
    "comark": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
