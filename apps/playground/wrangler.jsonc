{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hollware-playground",
  "main": "src/index.ts",
  // The latest compatibility date the workerd bundled with wrangler supports.
  "compatibility_date": "2026-10-06",
  // From the 2026-08-04 compatibility date Workers turn Node.js compatibility on by default.
  // Hollware runs without it, and so does everything that tests Hollware.
  // global_fetch_strictly_public: the OAuth server fetches the metadata documents of clients
  // (CIMD) over the public internet only, never through the zone (ADR-026).
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "global_fetch_strictly_public",
  ],
  // No anonymous wrangler telemetry from this repository.
  "send_metrics": false,
  // Every minute: publishes the scheduled entries whose time has come (ADR-025).
  "triggers": { "crons": ["* * * * *"] },
  // The publication events (ADR-025): the Worker sends them, consumes them, and keeps the ones it
  // could not deliver after five tries in the dead-letter queue.
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "hollware-playground-events" }],
    "consumers": [
      {
        "queue": "hollware-playground-events",
        "max_retries": 5,
        "dead_letter_queue": "hollware-playground-events-dlq",
      },
    ],
  },
  // The admin, at /admin/ (ADR-026): its hashed files go straight to the browser, and every
  // other request reaches the Worker first, which serves the admin's page with its policy.
  "assets": {
    "directory": "node_modules/@hollware/admin/dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/admin/assets/*"],
  },
  "vars": {
    // The only Host and Origin Hollware answers. This is the URL `vp dev` serves; the harness
    // tests override it with http://localhost (test/harness/workers.ts).
    "HOLLWARE_PUBLIC_URL": "http://localhost:5199",
  },
  // The OAuth server's clients, grants and tokens (ADR-026). Placeholder id: local development and
  // tests never contact Cloudflare; a deploy needs the id of a namespace made with
  // `wrangler kv namespace create`.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollware-playground",
      // Placeholder: local development, tests and dry runs never contact Cloudflare.
      // A real deploy needs the id of a database created with `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // The server package ships its migrations; the playground applies them as they are.
      "migrations_dir": "node_modules/@hollware/server/migrations",
    },
  ],
  "services": [
    // Only for the tests of this repository: a binding of the Worker to its own `Probe`
    // entrypoint (src/probe.ts), which is how a Node.js test asks the isolate which Node.js
    // globals it has. A Hollware project has neither the binding nor the class.
    { "binding": "PROBE", "service": "hollware-playground", "entrypoint": "Probe" },
  ],
  // The demo on Cloudflare (v0.2): `CLOUDFLARE_ENV=demo vp build`, then `wrangler deploy` of the
  // build. Bindings do not inherit, so each one is named again here.
  "env": {
    "demo": {
      "name": "hollware-demo",
      "vars": { "HOLLWARE_PUBLIC_URL": "https://cms.demo.hollware.com" },
      "routes": [{ "pattern": "cms.demo.hollware.com", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      // No test probe in the demo.
      "services": [],
      // The namespace hollware-demo-oauth in the maintainer's account (created 2026-10-14).
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "f4b6a249127848139b0cb6c400ce0e0c" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hollware-demo",
          "database_id": "c11a42ee-5cf6-4809-911b-bd941affca6e",
          "migrations_dir": "node_modules/@hollware/server/migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "hollware-demo-events" }],
        "consumers": [
          {
            "queue": "hollware-demo-events",
            "max_retries": 5,
            "dead_letter_queue": "hollware-demo-events-dlq",
          },
        ],
      },
    },
    // Staging (v0.5): semantic search and analytics against the real Workers AI, Vectorize and
    // Analytics Engine, with a synthetic corpus, before the demo gets them. `CLOUDFLARE_ENV=staging
    // vp build`, then `wrangler deploy` of the build. A Vectorize index serves one model: another
    // model is another index here and in HOLLWARE_EMBEDDING_MODEL.
    "staging": {
      "name": "hollware-staging",
      "workers_dev": true,
      // Next to D1's primary (ENAM): a search makes several round trips to it, and from a colo
      // far away each one costs what the whole answer should.
      "placement": { "mode": "smart", "hint": "enam" },
      "vars": {
        "HOLLWARE_PUBLIC_URL": "https://hollware-staging.sergioazoc.workers.dev",
        "HOLLWARE_EMBEDDING_MODEL": "@cf/baai/bge-m3",
        "HOLLWARE_ANALYTICS_ACCOUNT_ID": "2aca825b41485fe1e2b99d2dfadcad5a",
        "HOLLWARE_ANALYTICS_DATASET": "hollware_staging_page_views",
      },
      "triggers": { "crons": ["* * * * *"] },
      "services": [],
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "hollware-staging-bge-m3" }],
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "hollware_staging_page_views" },
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "e85a150e74794fd6a8d5d83625d6e0ed" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hollware-staging",
          "database_id": "64b0a941-34ed-4da9-b439-22fcfd15d12a",
          "migrations_dir": "node_modules/@hollware/server/migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "hollware-staging-events" }],
        "consumers": [
          {
            "queue": "hollware-staging-events",
            "max_retries": 5,
            "dead_letter_queue": "hollware-staging-events-dlq",
          },
        ],
      },
    },
  },
}
