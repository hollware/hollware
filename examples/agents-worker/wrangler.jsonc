{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The agents of the playground's Hollware (v0.6): a reviewer, a translator and a weekly auditor,
  // which reach Hollware over MCP through a service binding and never publish.
  "name": "hollware-agents",
  "main": "src/index.ts",
  // The latest compatibility date the workerd bundled with wrangler supports.
  "compatibility_date": "2026-10-06",
  // From the 2026-08-04 compatibility date Workers turn Node.js compatibility on by default.
  // The agents need no Node.js.
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  // No anonymous wrangler telemetry from this repository.
  "send_metrics": false,
  // No cron trigger: Hollware's own wakes the agents every ten minutes, through its AGENTS binding
  // to the entrypoint HollwareAgents (src/index.ts). The free plan has five for the account.
  "vars": { "HOLLWARE_PUBLIC_URL": "http://localhost:5199" },
  // The secret HOLLWARE_AGENT_TOKEN: a personal token of the site with content:read and
  // content:write (`hollware token create --label agents`). AGENTS_WEBHOOK_URL, also a secret, is
  // where the weekly report goes as well, such as a Slack incoming webhook.
  "services": [{ "binding": "HOLLWARE", "service": "hollware-playground" }],
  "ai": { "binding": "AI" },
  // Placeholder id: local development never contacts Cloudflare.
  "kv_namespaces": [{ "binding": "AGENTS_KV", "id": "00000000000000000000000000000000" }],
  "env": {
    // Next to staging (v0.6), in the maintainer's account.
    "staging": {
      "name": "hollware-agents-staging",
      "workers_dev": false,
      "vars": { "HOLLWARE_PUBLIC_URL": "https://hollware-staging.sergioazoc.workers.dev" },
      "services": [{ "binding": "HOLLWARE", "service": "hollware-staging" }],
      "ai": { "binding": "AI" },
      "kv_namespaces": [{ "binding": "AGENTS_KV", "id": "6bb2386eb14f40178f283ea139de1b9e" }],
    },
  },
}
