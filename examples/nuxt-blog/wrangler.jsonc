{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hollware-nuxt-blog",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "send_metrics": false,
  "cache": { "enabled": true },
  "services": [
    { "binding": "HOLLWARE", "service": "hollware-playground", "entrypoint": "Hollware" },
  ],
  "env": {
    "demo": {
      "name": "hollware-worker-site-demo",
      "routes": [{ "pattern": "demo.hollware.com", "custom_domain": true }],
      "services": [{ "binding": "HOLLWARE", "service": "hollware-demo", "entrypoint": "Hollware" }],
    },
  },
}
