{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hollware-spike-d1",
  "main": "src/index.ts",
  // The latest compatibility date the workerd bundled with wrangler supports.
  // No `nodejs_compat` on purpose: the spike must run on the plain Workers runtime.
  "compatibility_date": "2026-10-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollware-spike-d1",
      // Placeholder: local development, tests and dry runs never contact Cloudflare.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Generated by drizzle-kit (see drizzle.config.ts), applied as they are.
      "migrations_dir": "migrations",
    },
  ],
}
