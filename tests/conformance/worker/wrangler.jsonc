{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hollware-conformance",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "global_fetch_strictly_public",
  ],
  "send_metrics": false,
  "vars": {
    "HOLLWARE_PUBLIC_URL": "http://127.0.0.1:8790",
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hollware-conformance",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "node_modules/@hollware/server/migrations",
    },
  ],
}
