{
  "name": "@hollware/nuxt",
  "version": "1.0.0",
  "description": "Read Hollware from a Nuxt site, over a service binding or HTTP.",
  "homepage": "https://hollware.com",
  "bugs": {
    "url": "https://github.com/hollware/hollware/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollware/hollware.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@comark/vue": "catalog:",
    "@hollware/client": "workspace:*",
    "@hollware/core": "workspace:*",
    "@nuxt/kit": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "h3": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "h3": "^1.15.0",
    "nitropack": "^2.13.0",
    "nuxt": "^4.6.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
