{
  "name": "create-hollware",
  "version": "1.3.0",
  "description": "Create a new Hollware project.",
  "homepage": "https://hollware.com",
  "bugs": {
    "url": "https://github.com/hollware/hollware/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollware/hollware.git",
    "directory": "packages/create-hollware"
  },
  "bin": {
    "create-hollware": "./src/index.ts"
  },
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "create-hollware": "./dist/index.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/sync-starter.ts && vp pack",
    "prepack": "node ../../scripts/sync-starter.ts",
    "test": "vp test",
    "publint": "publint --strict"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
